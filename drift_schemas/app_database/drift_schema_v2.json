  "fixed_sql": [
    {
      "name": "cars",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"cars\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"brand\" TEXT NOT NULL, \"model\" TEXT NOT NULL, \"year\" INTEGER NULL, \"plate_number\" TEXT NULL, \"fuel_type\" TEXT NOT NULL, \"tank_volume\" REAL NULL, \"initial_mileage\" INTEGER NOT NULL, \"photo_file_name\" TEXT NULL, \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)));"
        }
      ]
    },
    {
      "name": "fuel_entries",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"fuel_entries\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"car_id\" INTEGER NOT NULL REFERENCES cars (id) ON DELETE CASCADE, \"date\" INTEGER NOT NULL, \"mileage\" INTEGER NOT NULL, \"liters\" REAL NOT NULL, \"price_per_liter\" REAL NOT NULL, \"total_cost\" REAL NOT NULL, \"is_full_tank\" INTEGER NOT NULL CHECK (\"is_full_tank\" IN (0, 1)), \"station\" TEXT NULL, \"comment\" TEXT NULL);"
        }
      ]
    },
    {
      "name": "settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"settings\" (\"key\" TEXT NOT NULL, \"value\" TEXT NOT NULL, PRIMARY KEY (\"key\"));"
        }
      ]
    }
